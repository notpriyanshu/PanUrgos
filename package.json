{
  "name": "panurgos-studio",
  "productName": "PanUrgos Studio",
  "version": "1.0.0",
  "description": "PanUrgos Studio — a private, local-first AI code editor. Bring your own keys, run local LLMs (Unsloth, Ollama, LM Studio, llama.cpp) and coding agents. Zero telemetry.",
  "author": "PanUrgos",
  "main": "src/main/boot.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --inspect",
    "assets": "electron build/make-assets.js",
    "dist": "node build/build-installer.js"
  },
  "dependencies": {
    "monaco-editor": "0.52.2"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.panurgos.studio",
    "productName": "PanUrgos Studio",
    "copyright": "PanUrgos",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "LICENSE",
      "src/**/*",
      "build/icon.ico",
      "!node_modules/monaco-editor/{esm,dev,min-maps}/**",
      "!node_modules/monaco-editor/**/*.map"
    ],
    "extraResources": [
      {
        "from": "build/llama.cpp",
        "to": "llama.cpp"
      },
      {
        "from": "build/installer",
        "to": "installer"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "asar": true,
    "win": {
      "target": "dir",
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "PanUrgos opens the project folders you choose.",
        "LSApplicationCategoryType": "public.app-category.developer-tools"
      }
    },
    "dmg": {
      "title": "PanUrgos Studio",
      "background": "build/dmg-background.png",
      "iconSize": 96,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 190,
          "type": "file"
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "executableName": "panurgos-studio",
      "synopsis": "Private, local-first AI code editor",
      "desktop": {
        "entry": {
          "StartupWMClass": "PanUrgos Studio",
          "MimeType": "text/plain;text/x-python;application/javascript;application/json;text/x-c;text/x-c++;text/x-java;text/x-go;text/x-rust;"
        }
      }
    },
    "deb": {
      "depends": [
        "libvulkan1"
      ]
    },
    "fileAssociations": [
      {
        "ext": [
          "js",
          "ts",
          "tsx",
          "jsx",
          "json",
          "md",
          "py",
          "c",
          "cpp",
          "h",
          "hpp",
          "cs",
          "java",
          "kt",
          "go",
          "rs",
          "rb",
          "php",
          "swift",
          "lua",
          "sql",
          "sh",
          "yml",
          "yaml",
          "toml",
          "html",
          "css",
          "scss",
          "vue",
          "txt"
        ],
        "name": "Source code",
        "role": "Editor"
      }
    ]
  },
  "homepage": "https://github.com/notpriyanshu/PanUrgos"
}
